      "settings": {
        "foreground": "$dusk"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "$wattle-seed"
      }
    },
    {
      "scope": "entity.name.label",
      "settings": {
        "foreground": "$saltpan"
      }
    },
    {
      "name": "Heading # markers: yellow, not bold",
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "$spinifex"
      }
    },
    {
      "name": "Heading text: yellow and bold",
