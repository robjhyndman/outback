        "entity.name.section",
        "markup.heading.setext"
      ],
      "settings": {
        "foreground": "$spinifex",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading attributes {#sec-...}: yellow, not bold",
      "scope": "meta.heading-attributes",
      "settings": {
        "foreground": "$spinifex",
        "fontStyle": ""
      }
    },
    {
      "name": "Inline code: desert rose",
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "$desert-rose"
      }
    },
    {
      "name": "Operators: light blue",
      "scope": [
        "keyword.operator",
        "keyword.operator.member",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "$sky"
      }
    },
    {
      "name": "Keywords: violet",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "$mulla-mulla"
      }
    },
    {
      "name": "Link text in [text](url) and [text][ref]: sunset",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "$sunset"
      }
    },
    {
      "name": "Cross-references: ochre",
      "scope": "keyword.control.import.reference",
      "settings": {
        "foreground": "$ochre"
      }
    },
    {
      "name": "Math ($...$, $$...$$, LaTeX math): eucalyptus grey",
      "scope": [
        "markup.math.inline.markdown",
        "markup.math.block.markdown",
        "markup.math.inline.quarto",
        "markup.math.block.quarto",
        "meta.embedded.math.markdown",
        "meta.embedded.math.quarto",
        "meta.math.block.tex",
        "meta.math.block.latex",
        "support.class.math.block.tex",
        "support.class.math.block.environment.latex",
        "meta.function.environment.math.latex",
        "punctuation.definition.math.begin.markdown",
        "punctuation.definition.math.end.markdown",
        "keyword.control.import.math.begin.quarto",
        "keyword.control.import.math.end.quarto",
        "punctuation.section.embedded.begin.math.tex",
        "punctuation.section.embedded.end.math.tex",
        "constant.character.math.tex",
        "constant.numeric.math.tex",
        "constant.other.general.math.tex",
        "constant.other.math.tex",
        "entity.name.function.math.tex",
        "storage.type.function.math.tex",
        "support.function.sexpr.math.tex",
        "meta.function.math.tex",
        "line.separator.math.tex",
        "punctuation.line.separator.math.tex",
        "punctuation.definition.arguments.begin.math.tex",
        "punctuation.definition.arguments.end.math.tex",
        "punctuation.definition.constant.math.tex",
        "punctuation.definition.function.math.tex",
        "punctuation.math.begin.bracket.curly",
        "punctuation.math.begin.bracket.round",
        "punctuation.math.end.bracket.curly",
        "punctuation.math.end.bracket.round",
        "punctuation.math.bracket.pair.tex",
        "punctuation.math.bracket.pair.big.tex",
        "punctuation.math.operator.latex",
        "punctuation.math.operator.tex"
      ],
      "settings": {
        "foreground": "$eucalyptus"
      }
    },
    {
      "name": "YAML keys: ochre",
      "scope": [
        "entity.name.tag.yaml",
        "source.yaml meta.mapping.key string"
      ],
      "settings": {
        "foreground": "$ochre"
      }
