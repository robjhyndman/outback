    {
      "name": "Link URLs: sage",
      "scope": [
        "markup.underline.link",
        "markup.underline.link punctuation"
      ],
      "settings": {
        "foreground": "$sage"
      }
    },
    {
      "name": "Markers for bold, italic and inline code (**, *, `): smoke grey",
      "scope": [
        "punctuation.definition.bold",
        "punctuation.definition.italic",
        "punctuation.definition.raw"
      ],
      "settings": {
        "foreground": "$smoke"
      }
    },
    {
      "name": "Table pipes (|) and header rules (---): mulga",
      "scope": [
        "punctuation.definition.table.markdown",
        "punctuation.separator.table.markdown"
      ],
      "settings": {
        "foreground": "$mulga"
      }
    },
    {
      "name": "Hidden content in ::: {.content-hidden} divs: comment grey",
      "scope": "meta.content-hidden",
      "settings": {
        "foreground": "$smoke"
      }
    }
  ],
  "semanticTokenColors": {
    "newOperator": "$mulla-mulla",
    "stringLiteral": "$spinifex",
    "customLiteral": "$sage",
    "numberLiteral": "$dusk"
  }
